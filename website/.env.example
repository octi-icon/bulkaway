SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=mailer@wsitrashvalet.com
SMTP_PASS=
# Render preview uses RENDER_EXTERNAL_URL automatically. Set SITE_URL for the primary custom domain.
# SITE_URL=https://bulkaway.com
PUBLIC_LAUNCH=false
# Optional, browser-visible key. Restrict by website and Maps JavaScript/Places APIs.
GOOGLE_MAPS_BROWSER_KEY=
# Required for pickup submissions. Separate secret key: Geocoding API + server outbound IP restrictions.
GOOGLE_MAPS_SERVER_KEY=
# Helm intake hand-off (wsi_web_intake_v1). Both unset = disabled; the crew email still delivers.
# HELM_INTAKE_URL=https://<helm-host>
# Shared secret generated by the Helm owner; equals Helm's WSI_INTAKE_SECRET_BULK_AWAY. Server-only.
HELM_INTAKE_SECRET=
